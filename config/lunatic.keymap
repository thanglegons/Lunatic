/*
 * Cornix -> Lunatic dactyl-6x4-trackball ZMK keymap
 * Generated from cornix.vil.
 *
 * Notes:
 * - Cornix/Vial file has 50 active positions; Lunatic default has 46 bindings.
 * - Main alpha/number/symbol/function layout is preserved as closely as possible.
 * - Extra Cornix side keys are folded into the available thumb / outer positions.
 * - Trackball scroll: tap the SCROLL key to toggle MOUSE layer; while MOUSE layer is active,
 *   moving the trackball sends scroll events instead of pointer movement. Tap SCROLL again to return.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/pointing.h>
#include <input/processors.dtsi>

#define BASE  0
#define SYM   1
#define MOUSE 2
#define FN    3
#define OPT2  4

#define ______ &trans
#define XXXXX  &none
#define SCROLL &tog MOUSE

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200
#define ZMK_POINTING_DEFAULT_SCRL_VAL 900

&mmv_input_listener {
    input-processors = <&zip_xy_scaler 2 1>;
};

&msc_input_listener {
    input-processors = <&zip_scroll_scaler 2 1>;
};

&msc {
    acceleration-exponent = <1>;
    time-to-max-speed-ms = <100>;
    delay-ms = <0>;
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off {
    hold-time-ms = <3000>;
};

&mt {
    tapping-term-ms = <300>;
    flavor = "tap-preferred";
};

/ {
    input_processors {
        zip_wheel_scaler: zip_wheel_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };
    };
};

&msc_input_listener {
    speed_up {
        layers = <MOUSE>;
        input-processors = <&zip_wheel_scaler 3 1>;
    };
};

&trackball_listener {
    scroller {
        layers = <MOUSE>;
        input-processors = <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>, <&zip_xy_to_scroll_mapper>;
    };
};

/ {
    behaviors {
        Scroll_D_U: Scroll_D_U {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_D_U";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
            tap-ms = <20>;
        };

        Scroll_LR: Scroll_LR {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_LR";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;
            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
//          |-----------------------------------------------------------|    |-----------------------------------------------------------|
             &kp ESC   &kp Q     &kp W     &kp E     &kp R     &kp T        &kp Y     &kp U     &kp I     &kp O     &kp P     &kp BSPC
             &kp TAB   &kp A     &kp S     &kp D     &kp F     &kp G        &kp H     &kp J     &kp K     &kp L     &kp SEMI  &kp SQT
             &kp LSHFT &kp Z     &kp X     &kp C     &kp V     &kp B        &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH  &kp UP
//          |------------------------------ thumbs -------------------|    |------------------------------ thumbs -------------------|
             &kp LCTRL &kp LGUI  &kp LALT  &mo SYM   &kp SPACE             &kp ENTER &mo MOUSE &mo FN    &kp LEFT  &kp RIGHT
            >;
            sensor-bindings = <&Scroll_D_U>, <&Scroll_D_U>;
        };

        sym_layer {
            display-name = "Sym";
            bindings = <
             &kp ESC   &kp LS(N1) &kp LS(N2) &kp LS(N3) &kp LS(N4) &kp LS(N5)    &kp LS(N6) &kp LS(N7) &kp LS(N8) &kp LS(N9) &kp LS(N0) &kp LS(BSLH)
             XXXXX     XXXXX      XXXXX      &kp LS(BSLH) &kp SEMI &kp MINUS     &kp EQUAL  &kp LS(EQUAL) &kp LBKT &kp RBKT &kp LS(SEMI) &kp LS(SQT)
             XXXXX     XXXXX      XXXXX      XXXXX      &mkp MB2  &mkp MB1       &kp MINUS  &kp LS(MINUS) &kp LS(COMMA) &kp LS(DOT) &kp LS(FSLH) &kp GRAVE
             XXXXX     XXXXX      XXXXX      XXXXX      XXXXX                 &kp BSPC  XXXXX     XXXXX      XXXXX      XXXXX
            >;
            sensor-bindings = <&Scroll_LR>, <&Scroll_LR>;
        };

        mouse_layer {
            display-name = "Mouse";
            bindings = <
             &kp LS(GRAVE) &kp N1    &kp N2    &kp N3    &kp N4    &kp N5       &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp BSPC
             XXXXX         &kp N4    &kp LS(LBKT) &kp LS(RBKT) &kp LS(LBKT) &kp LS(RBKT)  &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT &kp LBKT  &kp RBKT
             XXXXX         XXXXX     &kp LBKT  &kp RBKT  &kp N9    &kp N0       &kp MINUS &kp LS(MINUS) &kp COMMA &kp DOT   &kp FSLH  &kp GRAVE
             XXXXX         XXXXX     XXXXX     XXXXX     &kp SPACE             XXXXX     XXXXX     XXXXX     XXXXX     XXXXX
            >;
            sensor-bindings = <&inc_dec_kp 0 0>, <&inc_dec_kp 0 0>;
        };

        fn_layer {
            display-name = "Fn";
            bindings = <
             XXXXX     &kp F1    &kp F2    &kp F3    &kp F4    &kp F5       &kp F6    &kp F7    &kp F8    &kp F9    &kp F10   &kp F11
             XXXXX     XXXXX     XXXXX     XXXXX     XXXXX     XXXXX        &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT XXXXX    XXXXX
             XXXXX     XXXXX     XXXXX     XXXXX     XXXXX     XXXXX        XXXXX     XXXXX     XXXXX     XXXXX     XXXXX    XXXXX
             XXXXX     XXXXX     XXXXX     XXXXX     XXXXX                 XXXXX     XXXXX     XXXXX     XXXXX     XXXXX
            >;
            sensor-bindings = <&inc_dec_kp 0 0>, <&inc_dec_kp 0 0>;
        };

        opt2_layer {
            display-name = "Opt2";
            bindings = <
             XXXXX XXXXX XXXXX XXXXX XXXXX XXXXX    XXXXX XXXXX XXXXX XXXXX XXXXX XXXXX
             XXXXX XXXXX XXXXX XXXXX XXXXX XXXXX    XXXXX XXXXX XXXXX XXXXX XXXXX XXXXX
             XXXXX XXXXX XXXXX XXXXX XXXXX XXXXX    XXXXX XXXXX XXXXX XXXXX XXXXX XXXXX
             XXXXX XXXXX XXXXX XXXXX XXXXX          XXXXX XXXXX XXXXX XXXXX XXXXX
            >;
        };
    };
};
